{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "env": [
        "HOST",
        "PORT",
        "MONGODB_URI",
        "LOG_LEVEL",
        "NODE_ENV",
        "APP_ENV",
        "ANICO_DEV_SERVICE",
        "MIGRATE_ON_START",
        "ANICO_API_MODE"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"],
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ]
    }
  }
}
