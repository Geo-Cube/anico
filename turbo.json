{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "passThroughEnv": [
        "AUTH_JWKS_JSON",
        "AUTH_JWKS_URL",
        "AUTH_ISSUER",
        "AUTH_AUDIENCE",
        "ANICO_DEV_AUTH_RELAY",
        "ANICO_DEV_AUTH_KEY",
        "BREEDER_VERIFICATION_BROKER_FILE",
        "ANIMAL_VERIFICATION_BROKER_FILE"
      ],
      "env": [
        "HOST",
        "PORT",
        "MONGODB_URI",
        "LOG_LEVEL",
        "NODE_ENV",
        "APP_ENV",
        "ANICO_DEV_SERVICE",
        "MIGRATE_ON_START",
        "ANICO_API_MODE",
        "BREEDER_SERVICE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"],
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ]
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "MONGOMS_SYSTEM_BINARY",
        "MONGOMS_VERSION",
        "MONGOMS_RUNTIME_DOWNLOAD"
      ],
      "passThroughEnv": ["NATS_SERVER_BINARY", "TMPDIR"]
    },
    "test:e2e": {
      "dependsOn": [
        "^build",
        "@anico/frontend#build",
        "@anico/auth-service#build",
        "@anico/breeder-service#build",
        "@anico/animal-service#build"
      ],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "HOME",
        "TMPDIR",
        "PLAYWRIGHT_*",
        "E2E_*",
        "NATS_SERVER_BINARY",
        "MONGOMS_*"
      ]
    },
    "test:load": {
      "dependsOn": [
        "^build",
        "@anico/frontend#build",
        "@anico/auth-service#build",
        "@anico/breeder-service#build",
        "@anico/animal-service#build"
      ],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "HOME",
        "TMPDIR",
        "LOAD_*",
        "NATS_SERVER_BINARY",
        "MONGOMS_*"
      ]
    }
  }
}
