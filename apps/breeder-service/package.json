{
  "name": "@anico/breeder-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/http",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "db:status": "tsx --env-file-if-exists=.env src/database/cli.ts status",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/database/cli.ts seed",
    "db:reset": "tsx --env-file-if-exists=.env src/database/cli.ts reset",
    "db:unlock": "tsx --env-file-if-exists=.env src/database/cli.ts unlock",
    "db:new": "tsx src/database/cli.ts new",
    "openapi": "tsx scripts/openapi.ts",
    "dev:remote": "node ../../scripts/dev-remote.mjs --service=breeder-service",
    "db:remote:status": "node ../../scripts/dev-remote.mjs --service=breeder-service --db=status",
    "db:remote:migrate": "node ../../scripts/dev-remote.mjs --service=breeder-service --db=migrate",
    "db:remote:seed": "node ../../scripts/dev-remote.mjs --service=breeder-service --db=seed",
    "db:remote:reset": "node ../../scripts/dev-remote.mjs --service=breeder-service --db=reset",
    "db:remote:unlock": "node ../../scripts/dev-remote.mjs --service=breeder-service --db=unlock"
  },
  "dependencies": {
    "@anico/auth": "^0.1.0",
    "@anico/shared-schemas": "^0.1.0",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "express": "^5.1.0",
    "jose": "^6.2.14",
    "mongoose": "^8.19.0",
    "multer": "^2.5.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "swagger-ui-dist": "^5.34.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.0",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^4.0.0"
  }
}
