# Only this service, shared schemas and auth enter the build.
**
!package.json
!package-lock.json
!tsconfig.base.json
!apps/
apps/**
!apps/breeder-service/
!apps/breeder-service/package.json
!apps/breeder-service/tsconfig.json
!apps/breeder-service/src/
!apps/breeder-service/src/**
!apps/breeder-service/migrations/
!apps/breeder-service/migrations/**
!apps/breeder-service/seeds/
!apps/breeder-service/seeds/*.mjs
!packages/
packages/**
!packages/shared-schemas/
!packages/shared-schemas/package.json
!packages/auth/
!packages/auth/package.json
!packages/auth/tsconfig.json
!packages/auth/src/
!packages/auth/src/**
!packages/shared-schemas/tsconfig.json
!packages/shared-schemas/src/
!packages/shared-schemas/src/**
!packages/shared-schemas/catalogs/
!packages/shared-schemas/catalogs/*.json

# Keep these excluded even if they are accidentally put inside src/.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/node_modules
**/dist
**/coverage
**/.git
**/.pulumi
**/.ssh
**/.aws
**/.secrets
**/secrets
**/id_rsa
**/id_ed25519
**/id_ecdsa
**/id_dsa
