# Only this service, shared schemas and workspace manifests enter the build.
**
!package.json
!package-lock.json
!tsconfig.base.json
!apps/
apps/**
!apps/*/
apps/*/**
!apps/*/package.json
!apps/auth-service/tsconfig.json
!apps/auth-service/src/
!apps/auth-service/src/**
!apps/auth-service/migrations/
!apps/auth-service/migrations/**
!apps/auth-service/seeds/
!apps/auth-service/seeds/*.mjs
!packages/
packages/**
!packages/*/
packages/*/**
!packages/*/package.json
!packages/auth/tsconfig.json
!packages/auth/src/
!packages/auth/src/**
!packages/shared-schemas/tsconfig.json
!packages/shared-schemas/src/
!packages/shared-schemas/src/**
!packages/shared-schemas/catalogs/
!packages/shared-schemas/catalogs/*.json
!infrastructure/
infrastructure/**
!infrastructure/package.json

# Keep these excluded even if they are accidentally put inside src/.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.p8
**/*.key
**/*.p12
**/*.pfx
**/node_modules
**/dist
**/coverage
**/.git
**/.pulumi
**/.ssh
**/.aws
**/.secrets
**/secrets
**/id_rsa
**/id_ed25519
**/id_ecdsa
**/id_dsa
