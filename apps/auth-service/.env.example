NODE_ENV=development
PORT=3001
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/anico_auth_local
LOG_LEVEL=info
MIGRATE_ON_START=false

# No provider is enabled until ALL its settings are present in private .env.
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
AUTH_ISSUER=http://127.0.0.1:3001
AUTH_AUDIENCE=anico-api-local
AUTH_SIGNING_KEY_FILE=.secrets/signing-key.pem
AUTH_GATEWAY_KEY_FILE=.secrets/gateway-key
AUTH_SESSION_SECONDS=28800
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET
# APPLE_CLIENT_ID / APPLE_TEAM_ID / APPLE_KEY_ID / APPLE_KEY_FILE
