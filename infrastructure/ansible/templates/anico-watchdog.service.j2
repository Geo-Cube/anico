# Managed by AniCo Ansible (monitoring.yml).
[Unit]
Description=AniCo VPS watchdog for Healthchecks.io
Documentation=file:///usr/local/libexec/anico-watchdog
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root jen kvůli čtení docker.sock (root:docker 0660); bez capabilities
# a se zbytkem systému jen pro čtení.
User=root
EnvironmentFile=/etc/anico/watchdog.env
Environment=DOCKER_CONFIG=/run/anico-watchdog
RuntimeDirectory=anico-watchdog
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/anico-watchdog
TimeoutStartSec=120
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
