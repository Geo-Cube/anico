# Managed by AniCo Ansible. TLS terminates at Cloudflare; this proxy has no host ports.
{% if anico_access.publish.administration %}
http:
  routers:
{% if anico_sso_only | default(false) %}
    anico-admin-password-disabled:
      rule: 'Host(`{{ anico_access.administratorHostname }}`) && ((PathRegexp(`^/login/*$`) && Method(`POST`)) || PathRegexp(`^/auth/link/*$`) || PathRegexp(`^/forgot-password/*$`) || PathPrefix(`/reset-password`))'
      entryPoints: [http]
      priority: 1000
      service: anico-admin
      middlewares: [anico-private-recovery-only]
{% endif %}
    anico-admin:
      rule: 'Host(`{{ anico_access.administratorHostname }}`)'
      entryPoints: [http]
      service: anico-admin
    anico-admin-realtime:
      rule: 'Host(`{{ anico_access.administratorHostname }}`) && (PathPrefix(`/app/`) || PathPrefix(`/apps`))'
      entryPoints: [http]
      service: anico-admin-realtime
    anico-admin-terminal:
      rule: 'Host(`{{ anico_access.administratorHostname }}`) && Path(`/terminal/ws`)'
      entryPoints: [http]
      service: anico-admin-terminal
{% if anico_sso_only | default(false) %}
  middlewares:
    anico-private-recovery-only:
      ipAllowList:
        sourceRange: ['127.0.0.1/32', '::1/128']
{% endif %}
  services:
    anico-admin:
      loadBalancer:
        servers: [{url: 'http://coolify:8080'}]
    anico-admin-realtime:
      loadBalancer:
        servers: [{url: 'http://coolify:6001'}]
    anico-admin-terminal:
      loadBalancer:
        servers: [{url: 'http://coolify:6002'}]
{% else %}
http: {}
{% endif %}
