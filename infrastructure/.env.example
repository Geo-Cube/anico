# Copy to infrastructure/.env.local. Values stay outside Git.
CLOUDFLARE_API_TOKEN=
# Used only when generating the first local Coolify installation secrets:
COOLIFY_ADMIN_EMAIL=
# HCLOUD_TOKEN may already be present in your shell environment.
# HCLOUD_TOKEN=
# Run npm run state:init:local -w @anico/infrastructure to configure local state.
# Configure manually only when choosing another backend:
# PULUMI_BACKEND_URL=file:///ABSOLUTE/PATH/TO/STATE
# PULUMI_CONFIG_PASSPHRASE_FILE=/ABSOLUTE/PATH/TO/PRIVATE/PASSPHRASE
