{
  "name": "@anico/shared-schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "catalogs/*.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalogs/dog-breeds.json": "./catalogs/dog-breeds.json",
    "./catalogs/horse-breeds.json": "./catalogs/horse-breeds.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
