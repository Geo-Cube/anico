{
  "name": "anico",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infrastructure"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run build --filter=@anico/shared-schemas && turbo watch dev",
    "dev:frontend": "turbo run build --filter=@anico/shared-schemas && turbo watch dev --filter=@anico/frontend",
    "dev:backend": "node scripts/dev-remote.mjs",
    "dev:remote": "node scripts/dev-remote.mjs",
    "test:dev-remote": "node --test scripts/tests/dev-remote.test.mjs",
    "test:deployment": "node --test scripts/tests/dev-deployment.test.mjs",
    "start": "npm run start --workspace=@anico/breeding-service",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "bash .github/scripts/check-secrets.sh",
    "containers:check": "bash scripts/check-containers.sh",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "db:remote:status": "node scripts/dev-remote.mjs --db=status",
    "db:remote:migrate": "node scripts/dev-remote.mjs --db=migrate",
    "db:remote:seed": "node scripts/dev-remote.mjs --db=seed",
    "db:remote:reset": "node scripts/dev-remote.mjs --db=reset",
    "db:remote:unlock": "node scripts/dev-remote.mjs --db=unlock",
    "service:new": "gen run service",
    "test:generators": "npm run build -w @anico/shared-schemas && node --test scripts/tests/service-generator.test.cjs",
    "module:new": "gen run module",
    "feature:new": "gen run feature",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:dev-tools": "node --test scripts/tests/dev-tools.test.mjs scripts/tests/frontend-proxy.test.mjs scripts/tests/dev-api.test.mjs",
    "dev:fullstack": "node scripts/dev-remote.mjs --frontend"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@turbo/gen": "^2.11.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
